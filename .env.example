# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional local server settings.
PORT=3000
TTS_RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=false

# Optional: set a password before exposing the app through a private web URL.
# Leave empty for local-only use.
APP_ACCESS_PASSWORD=
ALLOW_INSECURE_HTTP=false

# Optional: vídeo con presentador (solo en local, servicio Python de avatar-service/).
# En Cloud Run se desactiva solo (detecta K_SERVICE). AVATAR_ENABLED=false lo apaga también en local.
AVATAR_SERVICE_URL=http://127.0.0.1:8765
AVATAR_SERVICE_TOKEN=
AVATAR_ENABLED=true

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
